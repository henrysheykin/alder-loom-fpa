# Copy to .env.local for local runs. On Vercel set these in Project Settings -> Environment Variables.
SITE_PASSWORD=change-me
# optional named logins instead of / in addition to the shared password: name:password,name2:password2
SITE_USERS=
# random string, 32+ characters (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
# Claude API key from console.anthropic.com (needed for the AI analyst)
ANTHROPIC_API_KEY=
# optional, defaults to claude-sonnet-5-5
CLAUDE_MODEL=
